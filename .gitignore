# Root-level .gitignore for Inventory Management System

# ─── Secrets & Environment Variables ───────────────────────────────────────
.env
.env.local
.env.*.local

# ─── Node / npm ─────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Frontend build artifacts ───────────────────────────────────────────────
frontend/dist/
frontend/dist-ssr/

# ─── Python virtual environments & cache ────────────────────────────────────
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# ─── Editor / OS files ──────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Logs ───────────────────────────────────────────────────────────────────
logs/
*.log
